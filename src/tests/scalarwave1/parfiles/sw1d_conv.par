###################################################################
# Setup a 1d sine-wave
###################################################################
# modules we use

physics = scalarwave1

errorexit = abort
logfile_creation = no

###################################################################
# evolution

evolve_method = RK4
dt = auto
finaltime = 0.6

###################################################################
# initial mesh

amr_mesh_type = BoxMesh Line
amr_BoxMesh_npatches = 21
amr_mesh_xc = 0.5
amr_BoxMesh_dout = 0.02380952380952381 # is 1/(2*amr_BoxMesh_npatches)

amr_dir_active0 = 1
amr_dir_active1 = 0
amr_dir_active2 = 0
amr_n0 = 6 # 7  # i.e. N=6
amr_n1 = 1
amr_n2 = 1

iterate_parameters = yes
iterate_parameter1 = amr_BoxMesh_npatches  21 41 81 161
iterate_parameter2 = amr_BoxMesh_dout      0.02380952380952381 0.01219512195121951 0.006172839506172839 0.003105590062111801

###################################################################
# initial data

scalarwave1_k = 1 0 0

###################################################################
# output

#outputX0Y0Z0coord = Xb

0douttime = 0.01
0doutput = scalarwave1_pi_err

1douttime = 0.01
1doutput = scalarwave1_pi scalarwave1_pi_err

#2douttime = 0.01
#2doutput = scalarwave1_pi
#2dformat = sdmf
