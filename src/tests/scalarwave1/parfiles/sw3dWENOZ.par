###################################################################
# modules we use

physics = scalarwave1

###################################################################
# FV tests
coordinates_surface_metric = sqrtgdiag
coordinates_midpoint_data = yes
amr_uniform_p = 0 2 4 # 0 1 2 3 4 5 6
amr_fv_p      = 0 2 4 # 0 1 2 3 4 5 6 7
amr_fv_if_uniform = yes
#scalarwave1_numflux = LLF
fv_rec = WENOmZ_2
fv_flux = fnum # fnum_minus_fi
#fv_surface_interp = parabolic
#fv_WENOm3_opt_weightratio = 3 # 2
fv_divf_extrap = dnfn_extrap1 # no # divf_extrap1
fv_divf_extrap_s1 = 0.5

###################################################################
# checkpointing

checkpoint = yes
checkpoint_hours = 3
checkpoint_hours_quit = 5.8

###################################################################
# evolution

evolve_method = sspRK3 # RK4 # Euler
#evolve_filter = yes
#evolve_filter_s = 4
dt = auto # NOTE 6/30/22: auto2 makes dt so big that it's unstable!!!
dtfac         = 0.2
uniform_dtfac = 0.125
finaltime = 10

###################################################################
# initial mesh

amr_mesh_type = 7 CubedSpheres
amr_luni = 0 # 1

amr_n0 = 9
amr_n1 = 9
amr_n2 = 9

iterate_parameters = yes
iterate_parameter1 = amr_luni  0 1 2 3 4 5 6 7

###################################################################
# initial data

scalarwave1_k = 0.8  -0.5  0.33166247903554

###################################################################
# output

logfile_creation = no

0douttime = 0.1
0doutput = scalarwave1_pi scalarwave1_pi_err

1douttime = 0.1
1doutput = scalarwave1_pi scalarwave1_pi_err

2douttime = 0.1
2doutput = scalarwave1_pi
2dformat = xdmf
