###################################################################
# modules we use

physics = scalarwave1

###################################################################
# checkpointing

checkpoint = no # yes
checkpoint_hours = 1
checkpoint_hours_quit = 1.94

###################################################################
# evolution

evolve_method = sspRK3 # RK4 # Euler
dt = auto
finaltime = 0.4

###################################################################
# initial mesh

amr_mesh_type = 7 CubedSpheres
amr_luni = 1

amr_n0 = 7
amr_n1 = 6
amr_n2 = 5

###################################################################
# initial data

scalarwave1_k = 0.8  -0.5  0.33166247903554

###################################################################
# output

timer_on = no # yes

logfile_creation = no

0douttime = 0.4
0doutput = scalarwave1_pi scalarwave1_pi_err

1douttime = 0.4
1doutput = scalarwave1_pi

2douttime = 0.4
2doutput = scalarwave1_pi
2dformat = xdmf
