physics = SurfExchange

finaltime = 0

errorexit = abort # exit # abort
logfile_creation = yes
logfile_reproducible = yes
sysmon_hours = -1

amr_mesh_type = 3 dom1 CubedSpheres
amr_nmax = 20 # <--to speed up gridpoints_init(mesh);
amr_n0 =  5
amr_n1 =  4
amr_n2 =  3

iterate_parameters = no
iterate_parameter1 = amr_n0  4 6 8 10 12


#outputX0Y0Z0coord = Xb

1doutiter = 1
1doutput = SurfExchange_u SurfExchange_v

2doutiter = 1
2doutput = SurfExchange_u SurfExchange_v
